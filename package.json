{
  "name": "react-native-figma-blur",
  "version": "0.1.0",
  "description": "Figma-identical blur and Liquid Glass for React Native. One sigma model, two GPU backends, zero jank.",
  "license": "MIT",
  "author": "mowgli <mowglijuddi@gmail.com>",
  "homepage": "https://github.com/mowgli/react-native-figma-blur#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mowgli/react-native-figma-blur.git"
  },
  "bugs": {
    "url": "https://github.com/mowgli/react-native-figma-blur/issues"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "blur",
    "backdrop-filter",
    "backdrop-blur",
    "liquid-glass",
    "glassmorphism",
    "frosted-glass",
    "figma",
    "fabric",
    "new-architecture",
    "turbomodule",
    "renderEffect",
    "expo"
  ],
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.tsx",
  "source": "src/index.tsx",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.tsx",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "!android/build",
    "!android/.gradle",
    "!android/.cxx",
    "!android/generated",
    "!ios/build",
    "!**/__tests__",
    "!**/.*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "del-cli lib android/build example/android/build example/ios/build",
    "prepare": "bob build",
    "parity": "node parity/measure.mjs",
    "prepack": "bob build",
    "verify": "npm run typecheck && npm test && npm run parity"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "^19.2.0",
    "del-cli": "^5.1.0",
    "jest": "^29.7.0",
    "react": "19.2.8",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.43.0",
    "typescript": "^5.6.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/preset-typescript": "^7.25.0",
    "babel-jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/example/",
      "/lib/"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNFigmaBlurSpec",
    "type": "all",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.figmablur"
    },
    "ios": {
      "componentProvider": {
        "FigmaBlurView": "FigmaBlurViewComponentView"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
