{
  "name": "react-native-figma-blur",
  "version": "0.1.0",
  "description": "Figma-identical blur and Liquid Glass for React Native. One sigma model, two GPU backends, zero jank.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.tsx",
  "source": "src/index.tsx",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!**/__tests__",
    "!**/.*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "del-cli lib android/build example/android/build example/ios/build",
    "prepare": "bob build",
    "parity": "node parity/measure.mjs"
  },
  "keywords": [
    "react-native",
    "blur",
    "backdrop-filter",
    "liquid-glass",
    "glassmorphism",
    "figma",
    "fabric",
    "new-architecture"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "^19.2.0",
    "del-cli": "^5.1.0",
    "jest": "^29.7.0",
    "react": "19.2.8",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.43.0",
    "typescript": "^5.6.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/preset-typescript": "^7.25.0",
    "babel-jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/example/",
      "/lib/"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNFigmaBlurSpec",
    "type": "all",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.figmablur"
    },
    "ios": {
      "componentProvider": {
        "FigmaBlurView": "FigmaBlurViewComponentView"
      }
    }
  }
}
